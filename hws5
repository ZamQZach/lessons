def p(n):
    primes = []
    for i in range(2, n + 1):
        binary = bin(i)[2:]
        if binary == binary[::-1] and all(i % j for j in range(2, int(i**0.5) + 1)):
            primes.append(i)
    return primes

n = int(input("Введите максимальное число: "))

result = p(n)
print(f"Простые числа <= {n} с палиндромной двоичной записью: {result}")
